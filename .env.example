# Desktop uygulamasında yalnızca herkese açık Client Key bulunur.
TIKTOK_CLIENT_KEY=
TIKTOK_REDIRECT_URI=http://127.0.0.1:4173/auth/tiktok/callback
TIKTOK_TOKEN_BROKER_URL=https://mk-live-pro.vercel.app/api/tiktok/token
TIKTOK_REVOKE_BROKER_URL=https://mk-live-pro.vercel.app/api/tiktok/revoke

# TIKTOK_CLIENT_SECRET bu dosyaya veya masaüstü uygulamasına yazılmaz.
# Vercel Project Settings > Environment Variables içinde tutulur.
